{
  "description": "Workflows — declarative YAML automation engine",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh\" session_start.py", "timeout": 15}]}],
    "PostToolUse": [
      {"matcher": "Edit|Write", "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh\" trigger.py", "timeout": 10}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh\" trigger.py", "timeout": 10}]}
    ],
    "Stop": [{"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh\" trigger.py", "timeout": 10}]}]
  }
}
